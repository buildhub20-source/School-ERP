DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_management?schema=public"
APP_URL="http://localhost:3000"

# --- Payments (Razorpay). Leave empty to use the built-in sandbox checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Email (SMTP). Leave empty: emails are logged to the in-app Outbox.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="School Office <office@example.com>"

# --- SMS (MSG91). Leave empty: SMS are logged to the Outbox.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""
# DLT template id per message type (and optional _TA for Tamil), e.g. {"OTP":"…","FEE_REMINDER":"…","FEE_REMINDER_TA":"…","GENERAL":"…"}
MSG91_TEMPLATES=""

# --- WhatsApp Business Cloud API (Meta). Leave empty: logged to the Outbox.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved WhatsApp template name per message type, e.g. {"FEE_REMINDER":"fee_reminder","FEE_RECEIPT":"fee_receipt","GENERAL":"school_update"}
WHATSAPP_TEMPLATES=""

# --- Web push (generated by scripts/setup.ts if empty)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:office@example.com"

# --- Backups
PG_DUMP_PATH="pg_dump"
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="30"
# Optional: encrypt backups with this passphrase (keep it safe; needed to restore)
BACKUP_ENCRYPTION_KEY=""
# Optional: copy each backup off-site; {file} = the backup path, e.g. aws s3 cp {file} s3://school-backups/
BACKUP_COPY_COMMAND=""

# --- Run the automation scheduler inside the web server (set to false if you run "npm run worker" separately)
RUN_SCHEDULER="true"

# --- Allow the no-money sandbox checkout in a production build (staging/demo only; never on the live site)
PAYMENTS_SANDBOX="false"

# --- Allow npm run db:seed / db:reset on a production-like server (demo/staging only; creates accounts with published passwords)
# ALLOW_DEMO_SEED="1"

# --- Local demo only: fixed parent/driver login code (no SMS provider). Ignored on an https APP_URL or when MSG91 is set.
# DEMO_OTP="123456"
